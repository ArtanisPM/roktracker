{
  "$defs": {
    "GeneralConfig": {
      "description": "General application settings (game window, click offset).",
      "properties": {
        "window_title": {
          "default": "Rise of Kingdoms",
          "title": "Window Title",
          "type": "string"
        },
        "y_offset": {
          "default": 0,
          "title": "Y Offset",
          "type": "integer"
        }
      },
      "title": "GeneralConfig",
      "type": "object"
    },
    "ScanTimings": {
      "description": "Waiting timings (seconds) between actions during scanning.\n\nEvery wait also gets a random extra of 0..max_random seconds.\nRaise a value if the game is slow to open that screen, lower it to scan faster.",
      "properties": {
        "gov_open": {
          "default": 2.0,
          "title": "Gov Open",
          "type": "number"
        },
        "copy_wait": {
          "default": 0.2,
          "title": "Copy Wait",
          "type": "number"
        },
        "kills_open": {
          "default": 1.0,
          "title": "Kills Open",
          "type": "number"
        },
        "info_open": {
          "default": 1.0,
          "title": "Info Open",
          "type": "number"
        },
        "info_close": {
          "default": 0.5,
          "title": "Info Close",
          "type": "number"
        },
        "gov_close": {
          "default": 1.0,
          "title": "Gov Close",
          "type": "number"
        },
        "popup_dismiss": {
          "default": 0.5,
          "title": "Popup Dismiss",
          "type": "number"
        },
        "list_swipe": {
          "default": 1.0,
          "title": "List Swipe",
          "type": "number"
        },
        "end_of_list": {
          "default": 2.0,
          "title": "End Of List",
          "type": "number"
        },
        "max_random": {
          "default": 0.5,
          "title": "Max Random",
          "type": "number"
        }
      },
      "title": "ScanTimings",
      "type": "object"
    }
  },
  "description": "Collection of all globally configured values.\n\nIt uses default values or loads from the config.json file.",
  "properties": {
    "timings": {
      "$ref": "#/$defs/ScanTimings",
      "default": {
        "gov_open": 2.0,
        "copy_wait": 0.2,
        "kills_open": 1.0,
        "info_open": 1.0,
        "info_close": 0.5,
        "gov_close": 1.0,
        "popup_dismiss": 0.5,
        "list_swipe": 1.0,
        "end_of_list": 2.0,
        "max_random": 0.5
      }
    },
    "general": {
      "$ref": "#/$defs/GeneralConfig",
      "default": {
        "window_title": "Rise of Kingdoms",
        "y_offset": 0
      }
    }
  },
  "title": "AppConfig",
  "type": "object"
}
