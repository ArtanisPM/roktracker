{
  "$defs": {
    "RankingMisc": {
      "description": "Additional info how to handle the scan.\n\nAttributes:\n    threshold (int): The threshold value to use when preprocessing the image\n    invert (bool): Whether to invert the image before OCR\n    scroll (tuple[int, int, int, int]): The drag (x1, y1, x2, y2) that scrolls the list\n        by exactly one screen of governors after each batch\n    scroll_duration (float): Seconds the scroll drag takes",
      "properties": {
        "threshold": {
          "title": "Threshold",
          "type": "integer"
        },
        "invert": {
          "title": "Invert",
          "type": "boolean"
        },
        "scroll": {
          "default": [
            0,
            0,
            0,
            0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Scroll",
          "type": "array"
        },
        "scroll_duration": {
          "default": 0.6,
          "title": "Scroll Duration",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "invert"
      ],
      "title": "RankingMisc",
      "type": "object"
    },
    "UIConfig": {
      "description": "UI configuration for a batch on the ranking screen.\n\nAttributes:\n    name_normal (list[tuple[int, int, int, int]]): The ROI where the name is located normally\n    score_normal (list[tuple[int, int, int, int]]): The ROI where the score is located normally\n    name_last (list[tuple[int, int, int, int]]): The ROI where the name is located when at the end of the rankings\n    score_last (list[tuple[int, int, int, int]]): The ROI where the score is located when at the end of the rankings",
      "properties": {
        "name_normal": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Name Normal",
          "type": "array"
        },
        "score_normal": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Score Normal",
          "type": "array"
        },
        "name_last": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Name Last",
          "type": "array"
        },
        "score_last": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Score Last",
          "type": "array"
        }
      },
      "required": [
        "name_normal",
        "score_normal",
        "name_last",
        "score_last"
      ],
      "title": "UIConfig",
      "type": "object"
    }
  },
  "description": "Config options related to a ranking scan.",
  "properties": {
    "calibrated": {
      "default": false,
      "title": "Calibrated",
      "type": "boolean"
    },
    "scan_path": {
      "title": "Scan Path",
      "type": "string"
    },
    "filename_prefix": {
      "title": "Filename Prefix",
      "type": "string"
    },
    "govs_per_screen": {
      "title": "Govs Per Screen",
      "type": "integer"
    },
    "last_different": {
      "title": "Last Different",
      "type": "boolean"
    },
    "ui_config": {
      "$ref": "#/$defs/UIConfig"
    },
    "misc": {
      "$ref": "#/$defs/RankingMisc"
    }
  },
  "required": [
    "scan_path",
    "filename_prefix",
    "govs_per_screen",
    "last_different",
    "ui_config",
    "misc"
  ],
  "title": "RankingConfig",
  "type": "object"
}
